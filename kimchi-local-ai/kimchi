function resolveSpec(spec){
  const rank=id=>/q4f16/i.test(id)?0:(/q4f32/i.test(id)?2:1);
  for(const pattern of spec.patterns){
    let best=null;
    for(const m of catalog){
      if(typeof m?.model_id!=="string"||!pattern.test(m.model_id))continue;
      if(!best||rank(m.model_id)<rank(best.model_id))best=m;
    }
    if(best)return best;
  }
  return null;
}
function buildExtraSpecs(){
  const taken=new Set(SPECS.map(s=>resolveSpec(s)?.model_id).filter(Boolean));
  const isLLM=r=>r.model_type===undefined||r.model_type===0||r.model_type===webllm?.ModelType?.LLM;
  return catalog
    .filter(r=>r&&typeof r.model_id==="string"&&!taken.has(r.model_id)&&!/q4f32/i.test(r.model_id)&&isLLM(r))
    .sort((a,b)=>(a.vram_required_MB??1e9)-(b.vram_required_MB??1e9))
    .map(record=>({key:"catalog_"+record.model_id,title:record.model_id,
      family:"WebLLM built-in catalog model",patterns:[],record}));
}
function friendlyHint(error){
  const t=((error?.name||"")+" "+(error?.message||String(error||""))).toLowerCase();
  if(/contextwindowsizeexceeded|context window/.test(t))return "The chat is longer than the model's 1024-token context. Start a new chat.";
  if(/quota|storage is full/.test(t))return "iPhone storage quota reached while caching the model. Free space or pick a smaller model.";
  if(/device.*lost|devicelost|out of memory|oom/.test(t))return "The GPU ran out of memory or was reset. Close other apps, unload models, and try a smaller one.";
  if(/maxstoragebufferbindingsize|maxbuffersize|exceeds.*limit/.test(t))return "This model needs larger GPU buffers than this iPhone exposes. Pick a smaller model.";
  if(/cannot find model record|model record/.test(t))return "That model ID is not in the WebLLM "+WEBLLM_VERSION+" catalog.";
  if(/failed to fetch|networkerror|load failed|network/.test(t))return "Download failed. Check the connection (huggingface.co must be reachable) and retry.";
  if(/exitstatus|exit\(1\)|abort/.test(t))return "WebLLM's WASM runtime aborted, usually GPU memory or shader compile failure. Try a smaller model.";
  return "";
}
async function probeGPU(updateStatus=false){
  gpuAdapter=null;gpuState="probing";
  if(!window.isSecureContext){
    $("gpuInfo").textContent="WebGPU unavailable: page is not a secure context.";
    logMilestone("WebGPU probe skipped because the page is not a secure context.");
  }else if(!navigator.gpu || typeof navigator.gpu.requestAdapter!=="function"){
    $("gpuInfo").textContent="WebGPU API is not exposed by this browser or app web view.";
    logMilestone("WebGPU API unavailable: navigator.gpu.requestAdapter() is missing.");
  }else{
    try{
      logMilestone("Requesting WebGPU adapter…");
      gpuAdapter=await withTimeout(navigator.gpu.requestAdapter({powerPreference:"high-performance"}),"WebGPU adapter request",15000);
      if(!gpuAdapter){
        $("gpuInfo").textContent="WebGPU is exposed, but requestAdapter() returned null.";
        logMilestone("WebGPU adapter request returned null.");
      }else{
        const info=gpuAdapter.info||{};
        $("gpuInfo").textContent="WebGPU adapter ready · "+(info.description||info.device||info.vendor||"GPU adapter detected");
        logMilestone("WebGPU adapter ready. Features: "+[...gpuAdapter.features].join(", "));
      }
    }catch(gpuError){
      gpuAdapter=null;
      $("gpuInfo").textContent="WebGPU adapter failed: "+(gpuError?.message||String(gpuError));
      logMilestone("WebGPU probe failed independently: "+describeError(gpuError));
    }
  }
  gpuState=gpuAdapter?"ready":"unavailable";
  if(updateStatus&&![...models.values()].some(x=>x.status==="ready"))$("systemStatus").textContent=idleStatus();
  renderModels();
  return !!gpuAdapter;
}
