/* Mobile controls are wired before the module so they remain usable if the AI runtime fails. */
(function(){
  const $=id=>document.getElementById(id);
  const lock=$('lockscreen'),drawer=$('modelDrawer'),scrim=$('drawerScrim');
  function updateClock(){
    const now=new Date();
    const clock=$('lockClock'),date=$('lockDate'),model=$('lockModel');
    if(clock)clock.textContent=now.toLocaleTimeString([], {hour:'numeric',minute:'2-digit'});
    if(date)date.textContent=now.toLocaleDateString([], {weekday:'long',month:'long',day:'numeric'});
    if(model)model.textContent=window.__KIMCHI_ACTIVE_MODEL__||'No model loaded';
  }
  function openLock(e){e?.preventDefault();updateClock();lock?.classList.add('open');lock?.setAttribute('aria-hidden','false');document.body.classList.add('locked');}
  function closeLock(e){e?.preventDefault();lock?.classList.remove('open');lock?.setAttribute('aria-hidden','true');document.body.classList.remove('locked');}
  function openModels(e){e?.preventDefault();drawer?.classList.add('open');scrim?.classList.add('open');scrim?.setAttribute('aria-hidden','false');}
  function closeModels(e){e?.preventDefault();drawer?.classList.remove('open');scrim?.classList.remove('open');scrim?.setAttribute('aria-hidden','true');}
  $('lockButton')?.addEventListener('click',openLock);
  $('unlockButton')?.addEventListener('click',closeLock);
  lock?.addEventListener('click',e=>{if(e.target===lock)closeLock(e)});
  $('lockCardTest')?.addEventListener('change',e=>{
    const card=lock?.querySelector('.lock-card');if(!card)return;
    card.style.background=e.target.checked?'rgba(10,16,27,.52)':'transparent';
    card.style.borderColor=e.target.checked?'#ffffff35':'transparent';
  });
  const THEME_BG={gemini:'#10131b',claude:'#262624',chatgpt:'#212121',deepseek:'#14161c',kimchi:'#080b12'};
  function applyTheme(t){
    if(!THEME_BG[t])t='gemini';
    if(t==='gemini')document.documentElement.removeAttribute('data-theme');else document.documentElement.setAttribute('data-theme',t);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content',THEME_BG[t]);
    const sel=$('themeSelect');if(sel)sel.value=t;
    try{localStorage.setItem('kimchi.theme.v1',t)}catch(_){}
  }
  $('themeSelect')?.addEventListener('change',e=>applyTheme(e.target.value));
  let savedTheme='gemini';try{savedTheme=localStorage.getItem('kimchi.theme.v1')||'gemini'}catch(_){}
  applyTheme(savedTheme);
  $('modelsButton')?.addEventListener('click',openModels);
  $('closeModels')?.addEventListener('click',closeModels);
  scrim?.addEventListener('click',closeModels);
  $('wallpaperButton')?.addEventListener('click',e=>{e.preventDefault();$('wallpaperDrawer')?.classList.toggle('open')});
  $('closeWallpaper')?.addEventListener('click',e=>{e.preventDefault();$('wallpaperDrawer')?.classList.remove('open')});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeLock();closeModels();$('wallpaperDrawer')?.classList.remove('open')}});
  window.__KIMCHI_UPDATE_LOCKSCREEN__=updateClock;
  window.setInterval(()=>{if(lock?.classList.contains('open'))updateClock()},15000);
})();
</script>

