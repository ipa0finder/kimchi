    const requiredFeatures=record.required_features||[];
    const availableFeatures=gpuAdapter?[...gpuAdapter.features]:[];
    const missingFeatures=requiredFeatures.filter(feature=>!availableFeatures.includes(feature));
    lastModelAttempt.required_features=requiredFeatures;
    lastModelAttempt.available_gpu_features=availableFeatures;
    if(missingFeatures.length){
      throw new Error("This model requires GPU feature(s) not exposed by the active iPhone adapter: "+missingFeatures.join(", ")+
        ". Kimchi will not silently switch to a heavier q4f32 model.");
    }
    const indexedDBUsable=await probeIndexedDB();
    const cacheStorageUsable=(typeof caches!=="undefined" && !!caches && typeof caches.open==="function");
    const cacheBackend=indexedDBUsable?"indexeddb":(cacheStorageUsable?"cache":null);
    lastModelAttempt.indexeddb_available=(typeof indexedDB!=="undefined");
    lastModelAttempt.indexeddb_open_test=indexedDBUsable;
    lastModelAttempt.cache_storage_available=cacheStorageUsable;
    if(!cacheBackend)throw new Error("No usable WebLLM cache backend: IndexedDB open test failed and CacheStorage is unavailable. Open this HTML in Safari or a viewer that grants persistent storage.");
    const appConfig={...webllm.prebuiltAppConfig,cacheBackend};
    lastModelAttempt.cache_backend=cacheBackend;
    lastModelAttempt.context_window_size=1024;
    entry.detail="Loading model weights and compiling GPU kernels…";
    renderModels();
    // In WebLLM 0.2.89 the third CreateMLCEngine argument is ChatOptions.
    // This is the supported way to cap the context/KV cache; ModelRecord.overrides
    // is not a reliable substitute for a per-load context override.
    const chatOpts={context_window_size:1024};
    const engine=await webllm.CreateMLCEngine(record.model_id,{
      appConfig,
      initProgressCallback:report=>{
        entry.progress=Math.round((report.progress||0)*100);
        entry.detail=report.text||"Loading model…";
        const now=performance.now();
        if(now-(entry.lastRender||0)>250||entry.progress>=100){entry.lastRender=now;renderModels();}
