  try{
    // Re-apply immediately before model initialization in case the viewer/runtime replaced console.
    const consoleGuardOK = window.__KIMCHI_INSTALL_CONSOLE_GUARD__?.() === true;
    lastModelAttempt.console_guard_before_load = consoleGuardOK;
    if(!consoleGuardOK) throw new Error("Console compatibility guard failed immediately before CreateMLCEngine().");
    try{webllm.setLogLevel?.("DEBUG")}catch{}
