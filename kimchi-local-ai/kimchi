async function probeIndexedDB(){
  if(typeof indexedDB==="undefined")return false;
  try{
    return await withTimeout(new Promise(resolve=>{
      let request;
      try{request=indexedDB.open("kimchi-storage-probe-v1");}
      catch(_){resolve(false);return;}
      request.onsuccess=()=>{try{request.result.close()}catch{}resolve(true)};
      request.onerror=()=>resolve(false);
      request.onblocked=()=>resolve(false);
    }),"IndexedDB availability test",5000);
  }catch(_){return false;}
}

async function loadModel(spec,record){
  if(!gpuAdapter&&navigator.gpu)await probeGPU(true);
  if(!navigator.gpu || !gpuAdapter){toast("WebGPU is not ready in this browser or app web view. Open Diagnostics for the adapter result.");return;}
  if(!webllm){toast("WebLLM is not initialized yet.");return;}
  // Run the engine in the page context. Blob-backed module workers can
  // crash or navigate some iOS HTML viewers to about:blank.
  lastModelAttempt={
    model_id:record.model_id,
    vram_required_MB:record.vram_required_MB??null,
    low_resource_required:record.low_resource_required??null,
    required_features:record.required_features||[],
