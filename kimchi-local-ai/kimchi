
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#080b12">
<title>Kimchi Local AI</title>
<style>
:root {
  color-scheme:dark;
  --bg:#080b12;--panel:#101622;--panel2:#151e2c;
  --line:#263348;--text:#edf3ff;--muted:#8493aa;
  --cyan:#62e6f5;--blue:#648cff;--green:#55e6a5;
  --red:#ff667d;--purple:#b99aff;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;
min-height:100vh}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.4;cursor:not-allowed}
.app{max-width:1500px;margin:auto;min-height:100vh;padding:18px}
header{display:flex;align-items:center;justify-content:space-between;
gap:15px;padding:10px 4px 20px;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:43px;height:43px;border-radius:13px;
display:grid;place-items:center;background:linear-gradient(135deg,#56e6f5,#7285ff);
color:#06101a;font-weight:950;font-size:22px}
.brand h1{font-size:21px;letter-spacing:3px;margin:0}
.brand small{color:var(--muted);font-size:11px;letter-spacing:1.5px}
.status{display:flex;align-items:center;gap:8px;color:var(--green);font-size:12px}
.dot{width:8px;height:8px;background:var(--green);border-radius:50%;
box-shadow:0 0 12px var(--green)}
.layout{display:grid;grid-template-columns:350px minmax(0,1fr);
gap:17px;padding-top:17px}
.panel{background:var(--panel);border:1px solid var(--line);
border-radius:16px;overflow:hidden}
.panel-head{padding:15px 17px;border-bottom:1px solid var(--line);
display:flex;align-items:center;justify-content:space-between}
.panel-head h2{font-size:13px;letter-spacing:1.5px;margin:0}
.muted{color:var(--muted)}
.small{font-size:11px}
.models{padding:12px;display:grid;gap:9px;max-height:54vh;overflow:auto}
.model{border:1px solid var(--line);background:#0c121d;
border-radius:12px;padding:12px}
.model-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.model-name{font-size:13px;font-weight:750;line-height:1.5}
.model-id{font-size:10px;color:var(--muted);overflow-wrap:anywhere;margin-top:4px}
.model-actions{display:flex;align-items:center;gap:8px;margin-top:11px}
.model-actions button{flex:1}
.tag{font-size:9px;font-weight:900;letter-spacing:.7px;
padding:4px 7px;border-radius:6px;white-space:nowrap}
.tag-perf{background:#342716;color:#ffc66d;border:1px solid #79572d}
.tag-ready{background:#12352b;color:var(--green)}
.tag-unavailable{background:#35202a;color:#ff91a3}
.tag-loading{background:#172c40;color:var(--cyan)}
.progress{height:4px;background:#253044;border-radius:5px;margin-top:10px;overflow:hidden}
.progress span{display:block;height:100%;width:0;background:var(--cyan);
transition:width .2s}
.btn{border:1px solid var(--line);border-radius:9px;padding:9px 12px;
background:var(--panel2);color:var(--text);font-size:12px;font-weight:700}
.btn.primary{background:linear-gradient(120deg,#54dced,#788dff);
color:#06101a;border:0}
.btn.danger{color:#ff8498;border-color:#693341}
.btn.ghost{background:transparent}
.btn.tiny{padding:6px 9px;font-size:11px}
.sidebar-bottom{padding:13px;border-top:1px solid var(--line)}
.info{font-size:11px;color:var(--muted);line-height:1.6}
.chat-panel{min-height:78vh;display:flex;flex-direction:column}
.toolbar{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
select{background:#0b111c;color:var(--text);border:1px solid var(--line);
border-radius:9px;padding:9px;font-size:12px}
.chat{padding:20px;flex:1;overflow:auto;min-height:390px;max-height:65vh}
.welcome{text-align:center;max-width:540px;margin:75px auto;color:var(--muted)}
.welcome h2{color:var(--text);font-size:25px;letter-spacing:2px}
.welcome p{font-size:13px;line-height:1.7}
.message{margin:0 0 18px;display:flex;gap:10px;align-items:flex-start}
.avatar{width:29px;height:29px;flex:0 0 29px;border-radius:9px;
display:grid;place-items:center;background:#1b2b42;color:var(--cyan);
font-size:11px;font-weight:900}
.message.user .avatar{background:#25334e;color:#fff}
.bubble{min-width:0;max-width:900px;flex:1}
.msg-head{font-size:11px;color:var(--muted);margin-bottom:6px}
.msg-body{font-size:13px;line-height:1.75;white-space:pre-wrap;
overflow-wrap:anywhere}
.composer{padding:14px;border-top:1px solid var(--line)}
textarea{width:100%;min-height:75px;max-height:190px;resize:vertical;
background:#0b111c;color:var(--text);border:1px solid var(--line);
border-radius:12px;padding:13px;outline:none;font-size:14px;line-height:1.5}
textarea:focus{border-color:var(--cyan)}
.composer-bottom{display:flex;align-items:center;justify-content:space-between;
gap:10px;margin-top:10px}
.composer-bottom small{font-size:10px;color:var(--muted)}
.actions{display:flex;gap:8px}
.metrics{display:flex;gap:15px;flex-wrap:wrap;padding:10px 17px;
border-top:1px solid var(--line);font-size:10px;color:var(--muted)}
.metric strong{color:var(--cyan);font-weight:800}
.history-list{padding:10px;display:grid;gap:7px;max-height:210px;overflow:auto}
.history-item{display:flex;align-items:center;gap:7px}
.history-item button:first-child{flex:1;text-align:left;overflow:hidden;
text-overflow:ellipsis;white-space:nowrap}
.history-item button{min-width:0}
.mode-note{font-size:10px;color:var(--muted);line-height:1.5}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
background:#1c2a3b;border:1px solid #40536e;padding:11px 16px;
border-radius:10px;font-size:12px;z-index:10;display:none;max-width:90vw}
@media(max-width:850px){
 .app{padding:10px}.layout{grid-template-columns:1fr}
 .models{max-height:380px}.chat-panel{min-height:65vh}
 .chat{min-height:340px;max-height:none;padding:14px}
 header{padding-bottom:14px}.brand h1{font-size:18px}
}
@media(max-width:430px){
 .app{padding:8px}.toolbar{width:100%}.toolbar select{flex:1;min-width:0}
 .composer{padding:10px}.composer-bottom{align-items:flex-end}
 .composer-bottom small{max-width:160px}
 .btn{padding:10px}.welcome{margin:45px auto}
}

/* MotionBGs-inspired live wallpaper layer */
#wallpaperLayer{position:fixed;inset:0;z-index:0;overflow:hidden;background:#070b12;pointer-events:none}
#wallpaperVideo,#wallpaperImage{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}
#wallpaperScrim{position:absolute;inset:0;background:rgba(10,12,18,.46);transition:background .2s}
.app{position:relative;z-index:1;backdrop-filter:none}
.panel{background:rgba(14,21,33,.72);backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px);border-color:rgba(190,215,255,.16);box-shadow:0 12px 40px rgba(0,0,0,.16)}
header{border-bottom-color:rgba(190,215,255,.18)}
.model{background:rgba(8,14,24,.68)}
textarea,select,.btn{backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
textarea{background:rgba(7,13,23,.72);border-color:rgba(190,215,255,.2)}
.glass-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
#wallpaperDrawer{position:fixed;z-index:30;right:12px;top:72px;width:min(360px,calc(100vw - 24px));max-height:78vh;overflow:auto;padding:14px;border:1px solid rgba(210,225,255,.22);border-radius:17px;background:rgba(12,18,29,.88);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);box-shadow:0 20px 70px rgba(0,0,0,.45);display:none}
#wallpaperDrawer.open{display:block}
#wallpaperDrawer label{display:block;font-size:11px;color:var(--muted);margin:12px 0 5px}
#wallpaperDrawer input[type=url],#wallpaperDrawer input[type=text]{width:100%;padding:10px;border-radius:9px;border:1px solid var(--line);background:#0b111c;color:var(--text)}
.drawer-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.drawer-row>*{flex:1;min-width:0}
#lockscreen{position:fixed;inset:0;z-index:25;display:none;align-items:center;justify-content:center;text-align:center;padding:24px;background:rgba(5,9,16,.14);backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px)}
#lockscreen.open{display:flex}
.lock-clock{font-size:clamp(64px,17vw,112px);font-weight:250;letter-spacing:-5px;text-shadow:0 4px 35px #0008}
.lock-date{font-size:17px;margin:4px 0 24px;text-shadow:0 2px 15px #000}
.lock-card{display:inline-block;padding:14px 20px;border-radius:18px;background:rgba(10,16,27,.52);border:1px solid #ffffff35;backdrop-filter:blur(16px)}
body.locked .app{filter:blur(8px);opacity:.13;pointer-events:none}
@media(max-width:600px){#wallpaperDrawer{top:62px}.glass-actions .btn{padding:8px 9px}.brand small{letter-spacing:.7px}}
@media(prefers-reduced-motion:reduce){#wallpaperVideo{display:none!important}}


/* Gemini-inspired mobile-first conversational workspace */
:root{--bg:#10131b;--text:#f3f4f8;--muted:#a6adbb;--line:rgba(255,255,255,.12);--panel:rgba(25,29,39,.64);--panel2:rgba(38,43,55,.72);--accent:#a9c7ff;--green:#78e0b0}
html,body{width:100%;min-height:100%;height:100%;overscroll-behavior:none}
body{background:#10131b;font-size:14px}
.app{max-width:1040px;height:100dvh;min-height:100dvh;margin:0 auto;padding:env(safe-area-inset-top) 18px env(safe-area-inset-bottom);display:flex;flex-direction:column}
header{flex:0 0 auto;min-height:64px;padding:9px 2px 12px;gap:10px;border-bottom:1px solid rgba(255,255,255,.10)}
.brand{gap:10px}.logo{width:35px;height:35px;border-radius:50%;font-size:18px;background:linear-gradient(145deg,#b8d0ff,#9e9be8)}
.brand h1{font-size:16px;letter-spacing:1.4px}.brand small{font-size:9px;letter-spacing:.8px;color:#aeb6c6}
.glass-actions{justify-content:flex-end;gap:6px}.glass-actions .btn{border-radius:999px;padding:8px 11px;font-size:10px;white-space:nowrap}
#modelsButton{border-color:rgba(185,205,255,.28);background:rgba(80,101,145,.22);max-width:190px;overflow:hidden;text-overflow:ellipsis}
.status{font-size:10px;white-space:nowrap}.dot{width:6px;height:6px}
.layout{display:block;flex:1;min-height:0;padding:0}
.layout>aside{position:fixed;z-index:31;left:0;top:0;bottom:0;width:min(390px,90vw);padding:calc(env(safe-area-inset-top) + 14px) 12px calc(env(safe-area-inset-bottom) + 14px);overflow-y:auto;background:rgba(17,21,30,.96);border-right:1px solid rgba(255,255,255,.14);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);transform:translateX(-105%);transition:transform .24s ease;box-shadow:20px 0 70px #0007}
.layout>aside.open{transform:translateX(0)}
#drawerScrim{position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.48);display:none;touch-action:manipulation}
#drawerScrim.open{display:block}
#modelDrawerHeader{display:flex;align-items:center;justify-content:space-between;padding:2px 3px 14px;color:#f3f4f8;font-size:13px;letter-spacing:.7px}
#modelDrawerHeader .btn{border-radius:999px}
.layout>aside .panel{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.10);border-radius:18px;box-shadow:none}
.layout>aside .panel-head{padding:12px 14px;border-bottom-color:rgba(255,255,255,.09)}
.layout>aside .panel-head h2{font-size:11px;letter-spacing:1px}
.models{padding:4px 12px;gap:0;max-height:48vh}
.model{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:3px 8px;padding:11px 2px;border:0;border-bottom:1px solid rgba(255,255,255,.08);border-radius:0;background:transparent}
.model-top{display:contents}.model-name{font-size:13px;font-weight:650}.model-top>div:last-child{justify-self:end}.model-id{grid-column:1/-1;font-size:9px;color:#a3adbf;margin:0;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.model-actions{grid-column:1/-1;margin-top:5px;gap:7px}.model-actions button{flex:0 0 auto;border-radius:999px;padding:6px 11px}.model-actions input{display:none}
.tag{font-size:8px;border-radius:999px}.progress{grid-column:1/-1;margin-top:5px}
.sidebar-bottom{padding:12px;border-top-color:rgba(255,255,255,.08)}
.layout>aside>section+section{margin-top:12px!important}
.chat-panel{width:min(100%,850px);height:100%;min-height:0;margin:0 auto;border:0;border-radius:0;background:transparent;box-shadow:none;display:flex;flex-direction:column;overflow:visible}
.chat-panel>.panel-head:first-child{flex:0 0 auto;padding:12px 3px 8px;border:0;min-height:42px}
.chat-panel>.panel-head:first-child h2{display:none}
.chat-panel>.panel-head:first-child .toolbar select{border-radius:999px;background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.13);padding:7px 11px;font-size:10px}
.chat-panel>.panel-head:nth-child(2){flex:0 0 auto;padding:0 3px 8px;border:0;min-height:24px}
#activeWorkers{font-size:10px!important;color:#aab4c6!important}
#clearChat,#unloadAll{border-radius:999px;padding:6px 9px;font-size:9px}
.chat{flex:1;min-height:0;max-height:none;overflow:auto;padding:16px clamp(2px,4vw,30px) 22px;scroll-behavior:smooth;overscroll-behavior:contain}
.welcome{max-width:620px;margin:clamp(55px,14vh,145px) auto 30px;text-align:left;color:#b3bdcd}
.welcome h2{font-size:clamp(26px,5vw,38px);font-weight:520;letter-spacing:-1.3px;line-height:1.18;margin:0 0 12px;background:linear-gradient(90deg,#dce7ff,#a9b8df);background-clip:text;-webkit-background-clip:text;color:transparent}
.welcome p{font-size:13px;line-height:1.65;margin:6px 0}.welcome>div:first-child{display:none}
.message{gap:10px;margin:0 auto 25px;max-width:760px;width:100%;align-items:flex-start}
.avatar{width:27px;height:27px;flex:0 0 27px;border-radius:50%;font-size:10px;background:linear-gradient(145deg,#b8d0ff,#8e9ce2);color:#111827}
.message.user .avatar{background:#30394a;color:#e6ebf5}
.bubble{max-width:none;min-width:0;padding-top:2px}
.msg-head{font-size:10px;color:#aeb8c9;margin:0 0 6px;letter-spacing:.2px}
.msg-body{font-size:14px;line-height:1.75;color:#edf0f7;white-space:pre-wrap}
.message.user .bubble{background:rgba(80,91,116,.28);border:1px solid rgba(210,220,245,.10);border-radius:20px;padding:12px 15px;max-width:min(90%,680px);margin-left:auto}
.message.user .msg-head{display:none}
.message.user .avatar{order:2;margin-left:4px}
.composer{flex:0 0 auto;position:relative;padding:10px 0 max(10px,env(safe-area-inset-bottom));border:0;background:transparent}
.composer textarea{display:block;min-height:54px;max-height:150px;resize:none;border-radius:26px;padding:15px 17px;background:rgba(31,36,49,.82);border:1px solid rgba(220,230,255,.16);box-shadow:0 8px 32px #0003;font-size:14px;line-height:1.45;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.composer-bottom{margin-top:8px;padding:0 5px;align-items:center}.composer-bottom small{font-size:9px;color:#9ba6b8}.actions{gap:6px}.actions .btn{border-radius:999px;padding:8px 14px;font-size:10px}
.metrics{flex:0 0 auto;justify-content:center;gap:12px;padding:5px 0 max(8px,env(safe-area-inset-bottom));border:0;font-size:9px;color:#929caf}
.metrics .metric strong{color:#c1d3ff}
.panel{border-color:rgba(255,255,255,.12)}
#wallpaperLayer{z-index:0}#wallpaperScrim{background:rgba(10,12,18,.50)}
#wallpaperDrawer{z-index:45;top:calc(env(safe-area-inset-top) + 68px)}
#lockscreen{z-index:60;padding:calc(env(safe-area-inset-top) + 24px) 20px calc(env(safe-area-inset-bottom) + 24px);background:rgba(5,8,15,.28)}
#lockscreen.open{display:flex}#lockscreen .lock-card{min-width:min(320px,85vw)}
body.locked .app{filter:blur(2px);opacity:.04;pointer-events:none}
#toast{z-index:80;bottom:calc(env(safe-area-inset-bottom) + 18px)}
html.model-loading #wallpaperLayer{visibility:hidden}
html.model-loading .panel,html.model-loading textarea,html.model-loading select{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
@media(max-width:600px){
 .app{padding-left:13px;padding-right:13px}
 header{min-height:58px}.brand small{display:none}.brand h1{font-size:15px}
 .glass-actions{gap:4px}.glass-actions .btn{padding:7px 9px;font-size:9px}
 #modelsButton{max-width:116px}
 .chat-panel>.panel-head:nth-child(2){padding-bottom:5px}
 .chat{padding:10px 1px 15px}
 .welcome{margin-top:clamp(60px,16vh,120px)}
 .message{margin-bottom:20px}.msg-body{font-size:14px}
 .composer{padding-bottom:max(8px,env(safe-area-inset-bottom))}
 .composer textarea{min-height:52px;border-radius:23px}
 .composer-bottom small{max-width:145px}
 .metrics{font-size:8px;gap:8px}
}
@media(prefers-reduced-motion:reduce){.layout>aside{transition:none}}


/* Wallpaper-first chat surface: keep the center clear and reserve glass for controls. */
.chat-panel.panel{background:transparent!important;border:0!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.chat-panel .chat{background:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.chat-panel>.panel-head,.chat-panel>.panel-head:nth-child(2){background:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.chat-panel .composer{background:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.chat-panel .composer textarea{background:rgba(12,16,25,.48)!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;border:1px solid rgba(225,235,255,.22);box-shadow:0 5px 22px rgba(0,0,0,.22)}
.chat-panel .message.assistant .msg-body{text-shadow:0 1px 3px rgba(0,0,0,.72)}
.chat-panel .message.user .bubble{background:rgba(35,43,59,.48)!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;box-shadow:0 3px 14px rgba(0,0,0,.16)}
.chat-panel .message .avatar{box-shadow:0 2px 10px rgba(0,0,0,.25)}


/* ===== Interface themes (Gemini = default, no data-theme attribute) ===== */
#themeSelect{border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);color:var(--text);font-size:10px;padding:6px 8px;max-width:96px}
html[data-theme="claude"]{--t-bg:#262624;--t-text:#f4f1ea;--t-grad:#d97757;--t-ongrad:#1f1e1d;--t-user:#3a3836;--t-aside:#201f1d;--t-ta:#30302e;--t-line:rgba(255,255,255,.14);--t-avbg:#d97757;--t-avfg:#1f1e1d;--t-h2:linear-gradient(90deg,#f4f1ea,#e3b9a5);--t-ai:ui-serif,Georgia,"Times New Roman",serif;--t-r:20px;--t-btn:10px;--t-logo-r:12px;--t-ls:.5px}
html[data-theme="chatgpt"]{--t-bg:#212121;--t-text:#ececec;--t-grad:#fff;--t-ongrad:#0d0d0d;--t-user:#303030;--t-aside:#171717;--t-ta:#303030;--t-line:rgba(255,255,255,.1);--t-avbg:#10a37f;--t-avfg:#fff;--t-h2:linear-gradient(90deg,#ececec,#ececec);--t-ai:ui-sans-serif,system-ui,-apple-system,sans-serif;--t-r:26px;--t-btn:999px;--t-logo-r:50%;--t-ls:0}
html[data-theme="deepseek"]{--t-bg:#14161c;--t-text:#e8ecf5;--t-grad:linear-gradient(120deg,#4d6bfe,#7a8dff);--t-ongrad:#fff;--t-user:#232a45;--t-aside:#101319;--t-ta:#1d212b;--t-line:rgba(120,140,255,.22);--t-avbg:#4d6bfe;--t-avfg:#fff;--t-h2:linear-gradient(90deg,#fff,#9fb0ff);--t-ai:ui-sans-serif,system-ui,-apple-system,sans-serif;--t-r:14px;--t-btn:10px;--t-logo-r:10px;--t-ls:.3px}
html[data-theme="kimchi"]{--t-bg:#080b12;--t-text:#edf3ff;--t-grad:linear-gradient(120deg,#54dced,#788dff);--t-ongrad:#06101a;--t-user:rgba(37,51,78,.7);--t-aside:#101622;--t-ta:#0b111c;--t-line:#263348;--t-avbg:#1b2b42;--t-avfg:#62e6f5;--t-h2:linear-gradient(90deg,#62e6f5,#7285ff);--t-ai:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;--t-r:12px;--t-btn:9px;--t-logo-r:13px;--t-ls:3px}
html[data-theme] body{background:var(--t-bg);color:var(--t-text)}
html[data-theme] #wallpaperLayer{background:var(--t-bg)}
html[data-theme] body:not(.has-wallpaper) #wallpaperScrim{display:none}
html[data-theme] .logo,html[data-theme] .btn.primary{background:var(--t-grad);color:var(--t-ongrad);border:0}
html[data-theme] .logo{border-radius:var(--t-logo-r)}
html[data-theme] .brand h1{letter-spacing:var(--t-ls)}
