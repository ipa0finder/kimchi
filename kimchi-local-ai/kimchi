function getContext(){
  // Context is capped at 1024 tokens (256 reserved for the reply); keep the newest turns that fit.
  const all=currentSession.messages.map(m=>({role:m.role,content:m.content}));
  const out=[];let used=0;
  for(let i=all.length-1;i>=0;i--){
    const cost=all[i].content.length;
    if(out.length&&used+cost>2000)break;
    out.unshift(all[i]);used+=cost;
  }
  while(out.length>1&&out[0].role!=="user")out.shift();
  return out;
}
// Use the model's catalog-provided conversation template without injecting a
// generic system message. This is important for small instruct models such as
// SmolLM2, whose native template is selected by WebLLM's ModelRecord.
async function generateOne(item,messages,onText){
  const {engine}=item.entry;
  const started=performance.now();
  const request={
    messages:messages.map(m=>({role:m.role,content:m.content})),
    stream:true,
    stream_options:{include_usage:true},
    temperature:0.8,
    top_p:0.9,
    max_tokens:256,
    frequency_penalty:0.15
  };
  lastInference={
    model_id:item.entry.modelId,
    started_at:new Date().toISOString(),
    stream:true,
    request_messages:request.messages.length,
    status:"requesting"
  };
  setDiagnostic("Streaming from "+item.entry.modelId+" using WebLLM's built-in chat template…");
  let answer="";
  const stream=await engine.chat.completions.create(request);
  if(!stream || typeof stream[Symbol.asyncIterator]!=="function"){
    throw new Error("WebLLM did not return an async response stream.");
  }
  let finishReason=null;
  let usage=null;
  for await(const chunk of stream){
    if(abortRequested){
      try{engine.interruptGenerate()}catch{}
      break;
    }
    const choice=chunk?.choices?.[0];
    if(choice?.finish_reason)finishReason=choice.finish_reason;
    if(chunk?.usage)usage=chunk.usage;
    let delta=choice?.delta?.content??"";
    if(Array.isArray(delta))delta=delta.map(part=>part?.text||part?.content||"").join("");
    if(typeof delta!=="string")delta=String(delta??"");
    if(delta){
      answer+=delta;
      onText(answer);
    }
  }
  answer=answer.trim();
  const latestUser=[...messages].reverse().find(m=>m.role==="user")?.content?.trim()||"";
  const exactEcho=!!answer&&!!latestUser&&answer.localeCompare(latestUser,undefined,{sensitivity:"accent"})===0;
  lastInference={
    model_id:item.entry.modelId,
    elapsed_ms:Math.round(performance.now()-started),
    stream:true,
    finish_reason:finishReason,
    prompt_tokens:usage?.prompt_tokens??null,
    completion_tokens:usage?.completion_tokens??null,
    response_chars:answer.length,
    exact_prompt_echo:exactEcho,
    status:abortRequested?"stopped":(exactEcho?"rejected-echo":(answer?"complete":"empty"))
  };
  if(abortRequested)return answer;
  if(exactEcho){
    setDiagnostic("MODEL ECHO DETECTED: WebLLM returned the latest user message verbatim. "+JSON.stringify(lastInference));
    throw new Error("The model returned your prompt verbatim. Kimchi rejected the echo.");
  }
  if(!answer){
    setDiagnostic("EMPTY MODEL COMPLETION: "+JSON.stringify(lastInference));
    throw new Error("The model completed without assistant text. See Diagnostics.");
  }
  return answer;
}
