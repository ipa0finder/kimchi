  busy=true;abortRequested=false;startedAt=performance.now();
  pauseWallpaperForGeneration(true);
  generatedWords=0;$("prompt").disabled=true;$("send").textContent="RUNNING";
  $("send").disabled=true;updateControls();
  $("prompt").value="";
  const sent=consumeAttachments(text);
  currentSession.messages.push({role:"user",content:sent.model,display:sent.display});
  addMessage("user",sent.display);saveCurrent();
  const base=getContext();
  try{
    if(mode==="single"){
      const item=chosen[0];const body=addMessage("assistant","",item.spec.title);
      const start=performance.now();
      const answer=await generateOne(item,base,value=>{
        body.textContent=value;generatedWords=value.trim().split(/\s+/).filter(Boolean).length;
        $("metricSpeed").textContent=(generatedWords/Math.max(.1,(performance.now()-start)/1000)).toFixed(1);
        $("chat").scrollTop=$("chat").scrollHeight;
      });
      if(answer)currentSession.messages.push({role:"assistant",content:answer+(abortRequested?"\n\n[Generation stopped]":""),model:item.spec.title});
      else if(!abortRequested){body.textContent="The model returned an empty response. Try a shorter prompt or reload the model.";setDiagnostic("Inference completed without text output for "+item.entry.modelId+".");}
    }
    if(mode==="parallel"){
      const outputs=await Promise.all(chosen.map(async item=>{
        const body=addMessage("assistant","",item.spec.title);
        const start=performance.now();let words=0;
        const answer=await generateOne(item,base,value=>{
          body.textContent=value;
          words=value.trim().split(/\s+/).filter(Boolean).length;
          $("metricSpeed").textContent=(words/Math.max(.1,(performance.now()-start)/1000)).toFixed(1);
          $("chat").scrollTop=$("chat").scrollHeight;
        });
        return {answer,model:item.spec.title};
      }));
      for(const out of outputs){
        if(out.answer)currentSession.messages.push({
          role:"assistant",content:out.answer,model:out.model
        });
      }
    }
    if(mode==="chain"){
      const first=chosen[0],second=chosen[1];
      const firstBody=addMessage("assistant","",first.spec.title+" · STEP 1");
      const firstAnswer=await generateOne(first,base,value=>{
        firstBody.textContent=value;$("chat").scrollTop=$("chat").scrollHeight;
      });
      if(firstAnswer)currentSession.messages.push({
        role:"assistant",content:firstAnswer,model:first.spec.title
      });
      if(!abortRequested&&firstAnswer){
        const secondBody=addMessage("assistant","",second.spec.title+" · STEP 2");
        const chainContext=[
          ...base,
          {role:"assistant",content:firstAnswer},
          {role:"user",content:"Continue from the previous model's response. Improve it, verify its reasoning, and provide the final answer."}
        ];
        const secondAnswer=await generateOne(second,chainContext,value=>{
          secondBody.textContent=value;$("chat").scrollTop=$("chat").scrollHeight;
        });
        if(secondAnswer)currentSession.messages.push({
          role:"assistant",content:secondAnswer,model:second.spec.title
        });
      }
    }
  }catch(error){
    addMessage("assistant","Generation error: "+String(error)+(friendlyHint(error)?"\n\n"+friendlyHint(error):""),"KIMCHI ERROR");
    toast("Generation failed. Check the browser console and model status.");
  }finally{
    busy=false;pauseWallpaperForGeneration(false);$("prompt").disabled=false;$("send").textContent="SEND ↗";
    $("metricTime").textContent=((performance.now()-startedAt)/1000).toFixed(1)+"s";
    $("metricSpeed").textContent=abortRequested?"Stopped":$("metricSpeed").textContent;
    saveCurrent();renderModels();updateControls();
    $("prompt").focus();
  }
}
function stopGeneration(){
  if(!busy)return;
  abortRequested=true;
  for(const entry of models.values()){
    if(entry.status==="ready")entry.engine?.interruptGenerate();
  }
  $("stop").disabled=true;toast("Stop requested for all active workers.");
}

// Wallpaper state: direct URLs persist; imported local files last for this viewer session.
const WALLPAPER_KEY="kimchi.wallpaper.v1";
let localWallpaperObjectURL=null;
function setWallpaperSource(url,type,label,persist=true){
  const video=$("wallpaperVideo"),img=$("wallpaperImage");
  video.pause();video.removeAttribute("src");video.load();img.removeAttribute("src");
  if(type==="video"){
    video.style.display="block";img.style.display="none";video.src=url;
    video.play().then(()=>{}).catch(()=>{$("wallpaperStatus").textContent="Wallpaper set. Tap the page once if iOS blocks autoplay.";});
  }else{
    img.style.display="block";video.style.display="none";img.src=url;
  }
  $("wallpaperStatus").textContent=label||"Wallpaper applied.";
  document.body.classList.add("has-wallpaper");
  if(persist){try{localStorage.setItem(WALLPAPER_KEY,JSON.stringify({url,type,label}))}catch{}}
}
function clearWallpaper(){
  $("wallpaperVideo").pause();$("wallpaperVideo").removeAttribute("src");$("wallpaperVideo").load();
  $("wallpaperImage").removeAttribute("src");$("wallpaperImage").style.display="none";$("wallpaperVideo").style.display="none";
  try{localStorage.removeItem(WALLPAPER_KEY)}catch{}
  if(localWallpaperObjectURL){URL.revokeObjectURL(localWallpaperObjectURL);localWallpaperObjectURL=null}
  $("wallpaperStatus").textContent="No wallpaper selected.";
  document.body.classList.remove("has-wallpaper");
}
function restoreWallpaper(){
  try{const saved=JSON.parse(localStorage.getItem(WALLPAPER_KEY)||"null");if(saved?.url&&saved?.type)setWallpaperSource(saved.url,saved.type,saved.label||"Restored wallpaper",false)}catch{}
  let dim=46;try{dim=Number(localStorage.getItem("kimchi.wallpaper.dim")||46)}catch{}
  $("wallpaperDim").value=String(dim);$("wallpaperDimValue").textContent=dim+"%";
  $("wallpaperScrim").style.background=`rgba(10,12,18,${dim/100})`;
}
function pauseWallpaperForGeneration(pause){
  const video=$("wallpaperVideo");
  if(!video.src)return;
  if(pause&&$("pauseOnGenerate").checked)video.pause();
  else if(!document.hidden)video.play().catch(()=>{});
}
$("applyWallpaper").addEventListener("click",()=>{
  const url=$("wallpaperUrl").value.trim();if(!url){toast("Paste a direct media URL first.");return}
  if(!/^https?:\/\//i.test(url)){toast("Use a direct HTTPS or HTTP media URL.");return}
  const path=url.split("?")[0].toLowerCase();const type=/\.(mp4|webm|mov|m4v)$/.test(path)?"video":"image";
  setWallpaperSource(url,type,"Applied remote "+type+" wallpaper");
});
$("wallpaperFile").addEventListener("change",event=>{
  const file=event.target.files?.[0];if(!file)return;
  if(!file.type.startsWith("video/")&&!file.type.startsWith("image/")){toast("Choose a video or image file.");return}
  if(localWallpaperObjectURL)URL.revokeObjectURL(localWallpaperObjectURL);
  localWallpaperObjectURL=URL.createObjectURL(file);
  setWallpaperSource(localWallpaperObjectURL,file.type.startsWith("video/")?"video":"image",file.name,false);
  try{localStorage.removeItem(WALLPAPER_KEY)}catch{}
});
$("clearWallpaper").addEventListener("click",clearWallpaper);
$("wallpaperDim").addEventListener("input",event=>{
  const value=Number(event.target.value);$("wallpaperDimValue").textContent=value+"%";
  $("wallpaperScrim").style.background=`rgba(10,12,18,${value/100})`;
  try{localStorage.setItem("kimchi.wallpaper.dim",String(value))}catch{}
});
function updateLockscreen(){
  const active=[...models.values()].find(m=>m.status==="ready"&&m.selected);
  window.__KIMCHI_ACTIVE_MODEL__=active?.modelId||"";
  window.__KIMCHI_UPDATE_LOCKSCREEN__?.();
}
document.addEventListener("visibilitychange",()=>{
  const video=$("wallpaperVideo");if(document.hidden)video.pause();else if(!busy&&video.src)video.play().catch(()=>{});
});
restoreWallpaper();updateLockscreen();

// ---- Attachments: text files are inlined into the prompt (trimmed to fit the 1024-token window); photos are listed only, since the loaded models are text-only.
let attachments=[];
const FILE_CHAR_BUDGET=1500;
const TEXT_EXT=/\.(txt|md|markdown|csv|tsv|json|js|ts|jsx|tsx|py|html|css|xml|ya?ml|log|ini|toml|sh|c|cpp|h|java|rb|go|rs|sql)$/i;
function renderAttachments(){
  const tray=$("attachTray");tray.replaceChildren();
  tray.classList.toggle("has",attachments.length>0);
  attachments.forEach((a,i)=>{
    const chip=document.createElement("div");chip.className="chip";
    if(a.kind==="image"){const im=document.createElement("img");im.src=a.url;im.alt="";chip.append(im);}
    else chip.append(document.createTextNode("📄"));
    const nm=document.createElement("span");nm.textContent=a.name;chip.append(nm);
    const x=document.createElement("button");x.type="button";x.textContent="×";x.setAttribute("aria-label","Remove "+a.name);
    x.onclick=()=>{if(a.url)URL.revokeObjectURL(a.url);attachments.splice(i,1);renderAttachments();};
    chip.append(x);tray.append(chip);
  });
}
$("attach").addEventListener("click",()=>$("attachInput").click());
$("attachInput").addEventListener("change",async event=>{
  const files=[...(event.target.files||[])];event.target.value="";
  for(const file of files){
    if(attachments.length>=4){toast("Up to 4 attachments per message.");break;}
    if(file.type.startsWith("image/")){
      attachments.push({kind:"image",name:file.name||"photo",url:URL.createObjectURL(file)});
      toast("Photo added. The loaded models are text-only and can't see images.");
    }else if(file.type.startsWith("text/")||file.type==="application/json"||TEXT_EXT.test(file.name||"")){
      if(file.size>2e6){toast(file.name+" is too large (2 MB max).");continue;}
      try{attachments.push({kind:"text",name:file.name,text:await file.text()});}
      catch(e){toast("Could not read "+file.name+".");}
    }else toast((file.name||"File")+": only photos and plain-text/code files are supported (no PDF or Word).");
  }
  renderAttachments();
});
function consumeAttachments(text){
  let budget=FILE_CHAR_BUDGET,model="";const notes=[];
  for(const a of attachments){
    if(a.kind==="image"){
      model+='[The user attached a photo named "'+a.name+'". You cannot see images, so do not describe it.]\n\n';
      notes.push(a.name+" (photo, not readable by this model)");
      URL.revokeObjectURL(a.url);
    }else{
      const body=a.text.slice(0,Math.max(0,budget));const cut=body.length<a.text.length;
      budget-=body.length;
      model+='File "'+a.name+'"'+(cut?" (trimmed)":"")+':\n"""\n'+body+'\n"""\n\n';
      notes.push(a.name+(cut?" (trimmed)":""));
      if(cut)toast("File trimmed to fit the 1024-token context window.");
    }
  }
  attachments=[];renderAttachments();
  return {model:model+text,display:text+(notes.length?"\n\n📎 "+notes.join(", "):"")};
}

$("send").addEventListener("click",sendMessage);
$("stop").addEventListener("click",stopGeneration);
$("newChat").addEventListener("click",newChat);
$("clearChat").addEventListener("click",()=>{
  sessions=sessions.filter(s=>s.id!==currentSession.id);
  saveSessions();renderHistory();
  currentSession=newSession();
  renderMessages();
  toast("Current conversation cleared from local history.");
});
$("copyDiagnostics").addEventListener("click",async()=>{
  const report=diagnosticReport();
  try{await navigator.clipboard.writeText(report);toast("Diagnostics copied.");}
  catch{setDiagnostic(report);toast("Clipboard unavailable. Diagnostics are displayed above.");}
});
$("unloadAll").addEventListener("click",unloadAll);
$("mode").addEventListener("change",updateControls);
$("prompt").addEventListener("keydown",e=>{
  if(e.key==="Enter"&&!e.shiftKey){
    e.preventDefault();if(!$("send").disabled)sendMessage();
  }
});

async function initialize(){
  let finalState="ERROR";
  let finalMessage="Initialization did not complete.";
  $("systemStatus").textContent="INITIALIZING";
  $("modelCount").textContent="Loading WebLLM…";
  logMilestone("Kimchi startup sequence entered.");
  logMilestone("Environment: secureContext="+!!window.isSecureContext+
    ", online="+!!navigator.onLine+
    ", navigator.gpu="+!!(navigator.gpu)+
    ", IndexedDB="+(typeof indexedDB!=="undefined")+
    ", CacheStorage="+(typeof caches!=="undefined")+".");
  try{
    if(!window.isSecureContext){
      logMilestone("WARNING: This page is not in a secure context. WebGPU generally requires HTTPS or a trusted app origin.");
    }
    if(!navigator.onLine){
      logMilestone("WARNING: Network is offline. Runtime import and uncached assets may fail.");
    }

    // Load the JavaScript runtime and model registry FIRST. A GPU adapter
    // failure must not prevent the UI from displaying the actual catalog.
    logMilestone("Importing WebLLM "+WEBLLM_VERSION+"…");
    window.__KIMCHI_CONSOLE_GUARD__=window.__KIMCHI_INSTALL_CONSOLE_GUARD__?.()||false;
    try{
      webllm=await withTimeout(import(WEBLLM_URL),"WebLLM esm.run import",45000);
    }catch(primaryError){
      logMilestone("esm.run failed: "+describeError(primaryError));
      const fallbackURL=`https://cdn.jsdelivr.net/npm/@mlc-ai/web-llm@${WEBLLM_VERSION}/+esm`;
      logMilestone("Trying jsDelivr fallback…");
      webllm=await withTimeout(import(fallbackURL),"WebLLM jsDelivr import",45000);
    }
    window.__KIMCHI_CONSOLE_GUARD__=window.__KIMCHI_INSTALL_CONSOLE_GUARD__?.()||false;
    if(typeof webllm?.CreateMLCEngine!=="function"){
      throw new Error("WebLLM imported, but CreateMLCEngine() is missing. The CDN returned an incompatible module.");
    }
    catalog=webllm?.prebuiltAppConfig?.model_list||[];
    if(!Array.isArray(catalog))throw new Error("WebLLM prebuiltAppConfig.model_list is not an array.");
    logMilestone("WebLLM imported. Actual built-in catalog contains "+catalog.length+" models.");

    extraSpecs=buildExtraSpecs();
    renderModels();
    renderHistory();
    renderMessages();

    // Probe WebGPU independently; cards show "CHECKING GPU…" until it settles.
    await probeGPU();
    // Refresh model cards after the asynchronous GPU probe completes.
    renderModels();
    updateControls();

    if(!catalog.length){
      finalState="ERROR";
      finalMessage="WebLLM imported, but its prebuilt model catalog is empty.";
    }else if(!gpuAdapter){
      finalState="RUNTIME READY · GPU OFFLINE";
      finalMessage="WebLLM and the model registry loaded ("+catalog.length+" models), but this app/browser has not provided a usable WebGPU adapter. Inference cannot start until WebGPU is available.";
    }else{
      finalState="READY · LOAD MODEL";
      finalMessage="WebLLM "+WEBLLM_VERSION+" initialized. "+catalog.length+
        " built-in catalog models detected. WebGPU adapter ready; load a compatible small model to begin.";
    }
    logMilestone(finalMessage);
  }catch(error){
    finalState="ERROR";
    finalMessage="Initialization failed: "+describeError(error);
    $("gpuInfo").textContent="Runtime initialization failed. See diagnostics.";
    if(!catalog.length && webllm?.prebuiltAppConfig?.model_list){
      catalog=webllm.prebuiltAppConfig.model_list;
      extraSpecs=buildExtraSpecs();
    }
    if(gpuState==="probing")gpuState="unavailable";
    renderModels();
    renderHistory();
    logMilestone(finalMessage);
    toast("Kimchi startup failed. Open Diagnostics for the exact error.");
  }finally{
    $("systemStatus").textContent=finalState;
    if(!catalog.length)$("modelCount").textContent="Catalog unavailable";
    setDiagnostic(lastDiagnostic+"\nFINAL STATUS: "+finalState+" — "+finalMessage);
  }
}
window.addEventListener("unhandledrejection",event=>{
  setDiagnostic(lastDiagnostic+"\nGLOBAL unhandledrejection: "+(event.reason?.stack||event.reason));
});
window.addEventListener("error",event=>{
  setDiagnostic(lastDiagnostic+"\nGLOBAL window.error: "+(event.message||"Unknown error")+" ("+(event.filename||"unknown file")+":"+(event.lineno||0)+")");
});
window.addEventListener("offline",()=>setDiagnostic("Network disconnected. New model downloads and package requests will fail; a previously cached model may still run."));
window.addEventListener("online",()=>setDiagnostic("Network restored. WebLLM can download uncached model files."));
initialize();
</script>
