<!-- Harden console in the page realm before any module import. -->
<script>
(function(){
  var buf=window.__KIMCHI_LOG_BUF__=[];
  window.__kimchiLog=function(tag,args){
    var t;
    try{t=args.map(function(a){
      if(a&&a.message)return (a.name||"Error")+": "+a.message;
      if(a&&typeof a==="object"){try{return JSON.stringify(a)}catch(_){return String(a)}}
      return String(a);
    }).join(" ");}catch(_){t="(unprintable)";}
    buf.push("["+tag+"] "+t.slice(0,400));if(buf.length>80)buf.shift();
  };
  function repairConsole(target){
    var methods=["log","warn","error","info","debug","trace"];
    if(!target || (typeof target!=="object" && typeof target!=="function")) target={};
    methods.forEach(function(name){
      var current;
      try{current=target[name]}catch(_){current=null}
      if(typeof current==="function"&&current.__kimchi)return;
      var fallback=(typeof current==="function")?current:null;
      var safe=function(){
        try{window.__kimchiLog(name,Array.prototype.slice.call(arguments))}catch(_){}
        if(!fallback)return;
        try{return Reflect.apply(fallback,target,Array.prototype.slice.call(arguments))}catch(_){return}
      };
      safe.__kimchi=true;
      // A native or host method may be non-writable; replace it with a plain JS function.
      try{Object.defineProperty(target,name,{configurable:true,enumerable:true,writable:true,value:safe})}
      catch(_){try{target[name]=safe}catch(__){}}
      try{if(typeof target[name]!=="function" || typeof target[name].bind!=="function"){
        var replacement=function(){return safe.apply(target,arguments)};
        Object.defineProperty(target,name,{configurable:true,writable:true,value:replacement});
      }}catch(_){ }
    });
    return target;
  }
  var current;
  try{current=window.console}catch(_){current=null}
  current=repairConsole(current);
  try{window.console=current}catch(_){ }
  // Re-apply the guard if an embedded viewer or library replaces window.console later.
  try{
    var descriptor=Object.getOwnPropertyDescriptor(window,"console");
    if(!descriptor || descriptor.configurable){
      var stored=current;
      Object.defineProperty(window,"console",{
        configurable:true,enumerable:true,
        get:function(){return stored},
        set:function(value){stored=repairConsole(value)}
      });
    }
  }catch(_){ }
  window.__KIMCHI_INSTALL_CONSOLE_GUARD__=function(){
    var c;try{c=window.console}catch(_){c=null}
    c=repairConsole(c);
    try{window.console=c}catch(_){ }
    return !!(c && ["log","warn","error","info","debug","trace"].every(function(k){
      try{return typeof c[k]==="function" && typeof c[k].bind==="function"}catch(_){return false}
    }));
  };
  window.__KIMCHI_CONSOLE_GUARD__=window.__KIMCHI_INSTALL_CONSOLE_GUARD__();
  try{
    var AP=window.GPUAdapter&&window.GPUAdapter.prototype;
    if(AP&&typeof AP.requestDevice==="function"&&!AP.requestDevice.__kimchi){
      var origRD=AP.requestDevice;
      AP.requestDevice=async function(desc){
        try{window.__kimchiLog("gpu",["requestDevice",JSON.stringify(desc||{})])}catch(_){}
        var dev=await origRD.apply(this,arguments);
        try{
          dev.addEventListener("uncapturederror",function(e){window.__kimchiLog("gpu",["UNCAPTURED ERROR",(e.error&&e.error.message)||String(e.error)])});
          dev.lost.then(function(i){window.__kimchiLog("gpu",["DEVICE LOST",i.reason,i.message])});
        }catch(_){}
        return dev;
      };
      AP.requestDevice.__kimchi=true;
    }
  }catch(_){}
})();
</script>

