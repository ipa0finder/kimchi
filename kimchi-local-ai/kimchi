    entry.selected=true;
    entry.detail="Ready · selected";
    $("systemStatus").textContent="MODEL ONLINE";
    lastModelAttempt={model_id:record.model_id,status:"loaded",vram_required_MB:record.vram_required_MB??null,required_features:record.required_features||[],cache_backend:cacheBackend,context_window_size:1024};
    window.__KIMCHI_ACTIVE_MODEL__=record.model_id;
    updateLockscreen();
    setDiagnostic("Model loaded successfully: "+record.model_id+". Inference is ready. Cache backend: "+cacheBackend+". Context window: 1024 tokens.");
    renderModels();toast(spec.title+" loaded successfully and selected.");
  }catch(error){
    if(models.get(spec.key)===entry)models.delete(spec.key);
    setDiagnostic([
      "MODEL LOAD FAILED ["+spec.title+"]",
      "Model ID: "+record.model_id,
      "VRAM required (MB): "+(record.vram_required_MB??"not specified by catalog"),
      "Low-resource model: "+(record.low_resource_required??"not specified by catalog"),
      "Required GPU features: "+((record.required_features||[]).join(", ")||"none listed"),
      "Cache backend: "+(lastModelAttempt?.cache_backend||"not configured"),
      "CacheStorage available: "+(typeof caches!=="undefined"),
      "IndexedDB available: "+(typeof indexedDB!=="undefined"),
      "GPU adapter features: "+(gpuAdapter?[...gpuAdapter.features].join(", "):"not captured"),
      (error?.name==="ExitStatus"||/Program terminated with exit\(1\)/.test(error?.message||""))
        ? "WASM EXIT DIAGNOSIS: WebLLM's WASM runtime aborted. The generic ExitStatus does not identify a single cause; on iPhone the leading checks are WebGPU device loss/OOM, shader compilation failure, or a damaged/incompatible model artifact. Wallpaper and blur were suspended during this attempt; context was capped at 1024 tokens."
        : "",
      "Stage reached: "+(entry.detail||"unknown")+" ("+(entry.progress||0)+"%)",
      "Runtime/GPU log before failure:\n"+((window.__KIMCHI_LOG_BUF__||[]).slice(-30).join("\n")||"(nothing captured)"),
      friendlyHint(error)?"LIKELY CAUSE: "+friendlyHint(error):"",
      describeError(error)
