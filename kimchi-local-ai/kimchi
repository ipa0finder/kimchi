function describeError(error){
  if(error==null)return "Unknown error (empty rejection)";
  const parts=[];
  try{parts.push("name: "+(error.name||"unknown"));}catch{}
  try{parts.push("message: "+(error.message||String(error)));}catch{}
  try{if(error.cause!==undefined)parts.push("cause: "+(error.cause?.message||String(error.cause)));}catch{}
  try{if(error.code!==undefined)parts.push("code: "+error.code);}catch{}
  try{if(error.stack)parts.push("stack: "+error.stack);}catch{}
  try{if(error.errors)parts.push("nested errors: "+Array.from(error.errors).map(x=>x?.message||String(x)).join(" | "));}catch{}
  return parts.join("\n")||String(error);
}
function withTimeout(promise,label,ms=10000){
